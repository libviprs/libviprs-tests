#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# pre-push: run the Docker test suite before pushing.
#
# This is a real file, tracked in libviprs-tests, and it is the hook: what
# `tools/install-hooks.sh` puts in `.git/hooks/pre-push` is a shim that runs
# this. It used to be a heredoc inside that script, and three things followed
# from the shape rather than from anything it does (libviprs/libviprs#695):
# a linter saw a string literal so ~120 lines of shell got no static checking,
# a guard could only assert on it by substring (two of them passed
# while the behaviour they named had been deleted), and it reached a repo only
# when somebody re-ran the installer, so at any moment an unknown set of
# checkouts was running an unknown vintage.
#
# Being a file fixes all three. It is linted in CI, the guards in
# `tests/prepush_gate_tests_the_pushed_tree.rs` and
# `tests/prepush_gate_cost_controls.rs` execute it with a synthetic ref-update
# on stdin, and a pull updates every repo pointing at it.
#
# To skip (emergency only): git push --no-verify. For a skip decision you do
# not trust, LIBVIPRS_PREPUSH_ALL=1 first.
# ---------------------------------------------------------------------------

# bash 3.2.57 is still both /bin/bash and /bin/sh on macOS, and its command
# substitution scanner cannot parse a `case` inside "$( ... )": the `)` that
# closes a pattern closes the substitution instead. This hook was bitten by
# exactly that. The `./*)` and `../*)` patterns that used to live inside the
# include_str! scan killed the substitution, the variable came back holding the
# error text, and every path in the falling-through arm answered inert, so a
# core push touching only .github/ or docs/ skipped the suite. That is issue
# #223 all over again, on the file that exists to stop it.
#
# The scan no longer has a `case` in it, so the parse is fixed rather than
# worked around. The floor stays because the failure mode is the problem: the
# substitution died silently, `|| true` swallowed the status, and the hook went
# on to give confident wrong answers. A hook that cannot do its job has to say
# so and stop, not pass.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    echo "pre-push: this hook needs bash 4 or newer, and it is running under" >&2
    echo "  ${BASH_VERSION:-an unknown shell}" >&2
    echo "" >&2
    echo "bash 3.2 mis-parses constructs this hook relies on and fails silently" >&2
    echo "when it does, which makes every skip decision below untrustworthy." >&2
    echo "Refusing the push rather than guessing." >&2
    echo "" >&2
    echo "Install a newer bash (brew install bash) and make sure it comes first" >&2
    echo "on PATH, since the shebang here is /usr/bin/env bash." >&2
    exit 1
fi

# A repo's main checkout and all of its linked worktrees share one hooks
# directory, and git invokes the hook with $0 inside that shared directory.
# Anything resolved from $0 is therefore the main checkout, whichever tree is
# actually being pushed, which is how every lane worktree on epic #520 gated
# against `main` instead of against its own branch (libviprs/libviprs#684).
# A worktree's .git is a file holding a gitdir: pointer rather than a
# directory, so walking up from it does not work either. Ask git, which runs
# hooks from the top of the working tree whose commits are going out.
TREE="$(git rev-parse --show-toplevel)"

# --git-common-dir is the *main* checkout's .git for a linked worktree, and a
# path relative to here for the main checkout itself, so resolve it from the
# tree rather than assuming it is absolute. Its parent tells us which repo
# this is, and where the sibling libviprs-tests checkout lives.
MAIN_CHECKOUT="$(cd "$TREE" && cd "$(dirname "$(git rev-parse --git-common-dir)")" && pwd)"
REPO_NAME="$(basename "$MAIN_CHECKOUT")"
WORKSPACE_ROOT="$(cd "$MAIN_CHECKOUT/.." && pwd)"
RUN_TESTS="$WORKSPACE_ROOT/libviprs-tests/tools/run-tests.sh"

# Hand the pushed tree to the suite in whichever slot it belongs. Without
# this run-tests.sh falls back to the sibling checkouts, which is the whole
# defect. There are two slots and this hook is only installed into the two
# repos that have one (libviprs/libviprs#691).
# Both slots get pinned, not just the one being pushed. run-tests.sh falls
# back to the siblings of wherever the script itself sits, and the script the
# line below may pick sits inside the worktree, whose neighbours are other
# lanes rather than the workspace. Naming both leaves nothing to infer.
case "$REPO_NAME" in
    libviprs)
        export LIBVIPRS_DIR="$TREE"
        export LIBVIPRS_TESTS_DIR="$WORKSPACE_ROOT/libviprs-tests"
        ;;
    libviprs-tests)
        export LIBVIPRS_TESTS_DIR="$TREE"
        export LIBVIPRS_DIR="$WORKSPACE_ROOT/libviprs"
        # A push that changes the harness gates on the harness it changes,
        # not on the copy sitting in the main checkout.
        if [ -x "$TREE/tools/run-tests.sh" ]; then
            RUN_TESTS="$TREE/tools/run-tests.sh"
        fi
        ;;
esac

if [ ! -f "$RUN_TESTS" ]; then
    echo "Warning: run-tests.sh not found at $RUN_TESTS"
    echo "Skipping pre-push tests. Install libviprs-tests as a sibling directory."
    exit 0
fi

# ---------------------------------------------------------------------------
# Is there anything in this push the suite could see?
# ---------------------------------------------------------------------------
# A full image build and suite run for a two-file workflow edit is what taught
# everyone to reach for --no-verify, and a hook nobody runs protects nothing
# (libviprs/libviprs#683). So skip, but only where the answer is knowable:
# paths that no test in either repo reads. That list is deliberately short.
#
# README.md and CHANGELOG.md are NOT on it. This suite's documentation guards
# read both, and they read them out of the *core* checkout as well as its own
# (tests/feature_rename_docs_present.rs), so a docs-only push to either repo
# can genuinely fail.
#
# .gitignore and .github/ used to answer per repo on the path alone, and both
# halves of that were wrong in a different way. The libviprs half called every
# core .github/ path inert without looking at the tree, while the core's own
# tests pull ci.yml, merge-gate.yml, publish.yml and the EPIC issue form in
# with include_str!, so a workflow-only push skipped the guard that reads it
# and failed in CI instead (#214's docs/* bug wearing a different prefix).
# The libviprs-tests half called all of .github/ and .gitignore read, which was
# right for the wrong reason: this repo's guards open them at run time, and the
# coverage rested on a pattern rather than on knowing who reads what. Narrowing
# it the way the libviprs half was narrowed would have reopened the hole,
# because the scan below could not see a run-time read (#224).
#
# So nothing answers on the repo any more. Both of them, in both repos, go to
# the scan, and the scan was taught what a run-time read looks like.
#
# The second half of the answer is not a pattern at all. `docs/*` says "this
# is not code", which is not the same as "nothing reads it", and the day a
# test pulled a doc in the two stopped meaning the same thing:
# libviprs/libviprs#1010 adds docs/pmtiles-benchmarks.md and reads it from
# tests/pmtiles_release_readiness.rs with include_str!, with two cells
# asserting on its columns and on the test names it quotes. A push changing
# only that file was skipping the suite and failing in CI instead. So for the
# patterns that claim nothing reads the file, go and look: scan the pushed
# tree's tests/ for paths, and anything one of them names is read, whatever the
# path looks like. docs/streaming-pdf-rotation.md has no reference anywhere in
# either repo and stays inert on the strength of that scan rather than on the
# strength of this comment.
#
# What the scan collects is every string literal under tests/ that is shaped
# like a repo-relative path, not only the ones handed to include_str!. That is
# what makes a run-time read visible, and the two live cases in #224 are why it
# also counts a literal naming a DIRECTORY as reading everything under it:
#
#   - tests/common/workflows.rs resolves a workflow by joining each entry of
#     WORKFLOW_DIRS to a file name. The only literal is ".github/workflows",
#     and the file's own path is spelled nowhere.
#   - the core's tests/local_gate_is_the_job_list.rs walks .github/workflows/
#     with read_dir and fails on any file there it has not classified. A new
#     workflow carries no literal of its own, and it is exactly the push that
#     guard exists to stop.
#
# Both come out read because ".github/workflows" names a directory above them.
# The same rule makes tests/pdfium_provenance.rs's read(".gitignore") count.
# It also catches tests/install_hooks_mirror_ci.rs's join(".github"), which only
# checks that a sibling checkout is a repo root and reads nothing under it, so
# every .github/ path in this repo comes out read partly on the strength of a
# locator. That's the cheap direction to be wrong in (see below), and the real
# readers above would keep those paths read without it.
#
# A literal only counts if it holds a / or starts with a dot. A bare word like
# "LICENSE" is far more often data than a path (the guard that pins this
# function's answers names it as one), and counting it would make the pinned
# skip list read itself as a reader. The cost is that a test opening a bare
# top-level name at run time is missed; include_str!("../LICENSE") is still
# seen, since include_str! literals count whatever their shape.
#
# What it still cannot see is a path assembled with no literal for it or any
# directory above it, say format!("{dir}/{name}") where dir itself came from
# somewhere other than a literal. Nothing short of running the code sees that.
# tests/prepush_gate_cost_controls.rs is what keeps the gap honest: it runs
# every tracked path in both repos through this function and pins the set that
# comes back inert, so a file the scan stops seeing fails there by name.
#
# The scan errs towards "read". A path-shaped literal in an assertion message
# or a fixture counts the same as one handed to read_to_string, and the cost of
# that is a suite run that was not strictly needed, which is the cheap mistake.
# The one file it leaves out is tests/prepush_gate_cost_controls.rs, whose
# stand-in trees spell .gitignore, .github/workflows/ci.yml and friends as
# fixtures. Counting them would keep those paths read in the real tree even if
# every real reader went away, and the pinned-set guard there could never say so.
#
# It fails closed too. If there's no tests/ to scan, or grep fails for any
# reason other than finding nothing, nothing is inert and the suite runs. A
# scan that couldn't look has no business saying a file is unread.
#
# And it only covers the pushed tree's tests/. On a core push, the
# libviprs-tests suite also runs, and if one of its tests read a core
# .github/, docs/ or .gitignore file at run time, nothing here would see it.
# There's no such read today; it's a known gap, not a covered case.
#
# When a path runs the suite because of the scan, the hook prints the literal
# that did it, after the ./ and ../ steps come off, as `(read via "<literal>"
# in tests/)`, so a surprise run is one line to explain.
#
# Set LIBVIPRS_PREPUSH_ALL=1 to run the suite whatever the paths say.

inert_path() {
    # Why the last path that wasn't inert reaches the suite, when the scan is
    # the reason. Empty for a path the patterns below never call inert.
    REACH_REASON=""
    case "$1" in
        .gitignore|.github/*|docs/*|.gitattributes|.editorconfig|LICENSE|LICENSE-*)
            : # decided by the scan below
            ;;
        *)
            return 1
            ;;
    esac

    # Every path a test under the pushed tree names, normalised to a
    # tree-relative path by dropping the leading ./ and ../ steps and any
    # trailing /. Two sources, unioned:
    #   - include_str! literals, whatever their shape, as before.
    #   - every other string literal made only of path characters that holds a
    #     / or starts with a dot. This is what sees a run-time read.
    # Computed once: the guard feeds every tracked path in the repo through
    # here. SCAN_OK stays false unless the scan ran to the end, and then
    # nothing is inert (see "fails closed" above).
    if [ -z "${READ_BY_A_TEST+set}" ]; then
        READ_BY_A_TEST=""
        SCAN_OK=false
        if [ -n "${TREE:-}" ] && [ -d "$TREE/tests" ]; then
            # The leading ./ and ../ steps come off in the sed, not in a shell
            # loop. A `case` here would be inside "$( ... )", which bash 3.2
            # cannot parse: see the version floor at the top of this file for
            # what that cost.
            #
            # The path-character class leaves out quotes and backslashes, so an
            # escaped quote inside some other string cannot pair up with a real
            # one and swallow the literal after it.
            #
            # grep -r rather than find -exec grep, because grep's own status is
            # the one that tells "no match" (1) from "couldn't read" (2), and
            # find folds both into one. Each grep maps 1 to success and lets
            # anything else through; pipefail and the && chain carry it out.
            if READ_BY_A_TEST="$(
                set -o pipefail
                {
                    { grep -rho --include='*.rs' --exclude='prepush_gate_cost_controls.rs' \
                        'include_str!("[^"]*")' "$TREE/tests" || [ $? -eq 1 ]; } |
                        sed -e 's/^include_str!("//' -e 's/")$//' &&
                    { grep -rho --include='*.rs' --exclude='prepush_gate_cost_controls.rs' \
                        '"[A-Za-z0-9_.+@-]*/[A-Za-z0-9_./+@-]*"\|"\.[A-Za-z0-9_./+@-]*"' "$TREE/tests" || [ $? -eq 1 ]; } |
                        sed -e 's/^"//' -e 's/"$//'
                } |
                sed -e 's|^\(\.\{1,2\}/\)*||' -e 's|/*$||' | sort -u
            )"; then
                SCAN_OK=true
            else
                READ_BY_A_TEST=""
            fi
        fi
    fi

    if [ "${SCAN_OK:-false}" != true ]; then
        REACH_REASON="the scan of tests/ could not run, so nothing counts as inert"
        return 1
    fi

    # The path itself and every directory above it. A literal naming any of
    # them reads this file: the path for a direct read, a directory for a
    # read_dir walk or a list of directories joined to a name.
    local targets above named target
    targets="$1"
    above="$1"
    while [ "${above%/*}" != "$above" ]; do
        above="${above%/*}"
        targets="$targets
$above"
    done

    # Most specific target first, so the literal reported is the closest one:
    # ".github/workflows" over ".github" for a workflow file.
    while IFS= read -r target; do
        while IFS= read -r named; do
            [ -n "$named" ] || continue
            # The tail form catches a literal that reached out of its own repo,
            # so a cross-checkout read is read rather than quietly inert.
            case "$named" in
                "$target"|*"/$target")
                    REACH_REASON="read via \"$named\" in tests/"
                    return 1
                    ;;
            esac
        done <<NAMED
$READ_BY_A_TEST
NAMED
    done <<TARGETS
$targets
TARGETS

    return 0
}

REF_UPDATES="$(cat)"
CHANGED=""
SKIP_SUITE=false

if [ "${LIBVIPRS_PREPUSH_ALL:-0}" != "1" ] && [ -n "$REF_UPDATES" ]; then
    UNKNOWN=false
    while read -r _local_ref local_oid _remote_ref remote_oid; do
        if [ -z "${local_oid:-}" ]; then
            continue
        fi
        # An all-zero local oid is a ref deletion: no content goes out.
        case "$local_oid" in
            *[!0]*) : ;;
            *)      continue ;;
        esac

        BASE=""
        case "${remote_oid:-}" in
            *[!0]*)
                if git cat-file -e "${remote_oid}^{commit}" 2>/dev/null; then
                    BASE="$remote_oid"
                fi
                ;;
        esac
        if [ -z "$BASE" ]; then
            # New branch. Compare against whatever the remote's default branch
            # already has, and give up rather than guess if that is not here.
            UPSTREAM="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
            if [ -z "$UPSTREAM" ]; then
                UPSTREAM="origin/main"
            fi
            BASE="$(git merge-base "$local_oid" "$UPSTREAM" 2>/dev/null || true)"
        fi
        if [ -z "$BASE" ]; then
            UNKNOWN=true
            break
        fi

        # Unguarded this is a `set -e` exit: a git failure here would abort
        # the push with nothing printed. A range we cannot diff is a range we
        # cannot judge, which is the same answer as a base we could not find.
        if ! REF_PATHS="$(git diff --name-only "$BASE" "$local_oid" --)"; then
            UNKNOWN=true
            break
        fi
        CHANGED="$CHANGED
$REF_PATHS"
    done <<REFS
$REF_UPDATES
REFS

    if [ "$UNKNOWN" = false ]; then
        SKIP_SUITE=true
        while IFS= read -r changed_path; do
            if [ -z "$changed_path" ]; then
                continue
            fi
            if inert_path "$changed_path"; then
                continue
            fi
            SKIP_SUITE=false
            echo "Pre-push: $changed_path can reach the suite, running it${REACH_REASON:+ ($REACH_REASON)}."
            break
        done <<PATHS
$CHANGED
PATHS
    fi
fi

if [ "$SKIP_SUITE" = true ]; then
    echo "Pre-push: nothing in this push reaches the test suite, skipping it."
    printf '%s\n' "$CHANGED" | sed '/^$/d; s/^/  /'
    echo "  (LIBVIPRS_PREPUSH_ALL=1 runs it anyway)"
    exit 0
fi

# git hands every hook a GIT_DIR (and, in a worktree, one pointing at the
# per-worktree admin directory), and it wins over -C and over the working
# directory for every git command anything below runs. Leaving it set made the
# suite report this push's HEAD as the revision of trees it had never looked
# at. The paths above are already resolved, so drop it here.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_QUARANTINE_PATH

echo "Running pre-push test suite on $TREE..."
if ! "$RUN_TESTS"; then
    echo ""
    echo "Pre-push tests failed. Push aborted."
    echo "Fix the failures or use: git push --no-verify"
    exit 1
fi
